# ==============================================================================
# AI Product Ops Research Agent - Environment Configuration
# ==============================================================================

# LLM Provider Configuration
LLM_API_KEY=your_llm_api_key_here
LLM_MODEL=gemini-2.5-flash
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions

# Provider-Specific API Keys
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Web Search & Documentation Retrieval APIs
SERPER_API_KEY=your_serper_api_key_here
TAVILY_API_KEY=your_tavily_api_key_here
FIRECRAWL_API_KEY=your_firecrawl_api_key_here

# Research Agent Execution Settings
DEFAULT_MODEL=gemini-2.5-flash
MAX_SEARCH_RESULTS=5
CONFIDENCE_THRESHOLD=0.75
RESEARCH_BATCH_SIZE=10
CACHE_ENABLED=true
CACHE_DIR=./data/cache
OUTPUT_DIR=./output
LOG_LEVEL=INFO